#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_LINE 1024

typedef struct _StackElement{
    double broj;
    struct _StackElement* next;
}StackElement;

StackElement* makeElement(double broj){
    StackElement* new=(StackElement*)malloc(sizeof(StackElement));
    if(!new){
        printf("Greska pri alokaciji memorije\n");
        return NULL;
    }
    new->broj=broj;
    new->next=NULL;
    return new;
}

int push(StackElement* head, double broj){
    StackElement* new=makeElement(broj);
    if(!new)return 1;
    new->next=head->next;
    head->next=new;
    return 0;
}

int pop(StackElement* head, double* broj){
    StackElement* top=head->next;
    if(top==NULL){
        printf("Greska: stog je prazan (fali broj u izrazu)\n");
        return 1;
    }
    *broj=top->broj;
    head->next=top->next;
    free(top);
    return 0;
}

int freeStack(StackElement* head){
    StackElement* temp=head->next;
    while(temp!=NULL){
        StackElement* next=temp->next;
        free(temp);
        temp=next;
    }
    head->next=NULL;
    return 0;
}

int calculate(StackElement* head, char operacija){
    double a, b, rezultat;

    if(pop(head,&b)!=0)return 1;
    if(pop(head,&a)!=0)return 1;

    switch(operacija){
        case '+':
            rezultat=a+b;
            break;
        case '-':
            rezultat=a-b;
            break;
        case '*':
            rezultat=a*b;
            break;
        case '/':
            if(b==0){
                printf("Greska: dijeljenje s nulom\n");
                return 1;
            }
            rezultat=a/b;
            break;
        default:
            printf("Greska: nepoznata operacija %c\n",operacija);
            return 1;
    }
    return push(head,rezultat);
}

int readFromFile(const char* filename, char* line){
    FILE* fp=fopen(filename,"r");
    if(!fp){
        printf("Greska pri otvaranju datoteke %s\n",filename);
        return 1;
    }
    if(fgets(line,MAX_LINE,fp)==NULL){
        printf("Datoteka %s je prazna\n",filename);
        fclose(fp);
        return 1;
    }
    fclose(fp);
    return 0;
}

int evaluatePostfix(const char* line, double* rezultat){
    StackElement head={.broj=0,.next=NULL};
    const char* p=line;
    char token[50];
    double broj;
    int n, len;

    while(sscanf(p,"%49s %n",token,&n)==1){
        p+=n;

        if(strlen(token)==1&&strchr("+-*/",token[0])!=NULL){
            if(calculate(&head,token[0])!=0){
                freeStack(&head);
                return 1;
            }
        }

        else if(sscanf(token,"%lf%n",&broj,&len)==1&&token[len]=='\0'){
            if(push(&head,broj)!=0){
                freeStack(&head);
                return 1;
            }
        }
        else{
            printf("Greska: nepoznat znak %s\n",token);
            freeStack(&head);
            return 1;
        }
    }

    if(pop(&head,rezultat)!=0){
        freeStack(&head);
        return 1;
    }
    if(head.next!=NULL){
        printf("Greska: previse brojeva u izrazu\n");
        freeStack(&head);
        return 1;
    }
    return 0;
}

int main(){
    char line[MAX_LINE];
    double rezultat;

    if(readFromFile("postfiks.txt",line)!=0)return 1;

    printf("Postfiks izraz: %s",line);
    if(line[strlen(line)-1]!='\n')printf("\n");

    if(evaluatePostfix(line,&rezultat)!=0){
        printf("Izraz nije ispravan.\n");
        return 1;
    }

    printf("Rezultat: %g\n",rezultat);
    return 0;
}
