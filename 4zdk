#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_LINE 1024

/* Jedan clan polinoma: koef * x^eksp */
typedef struct _Term{
    int koef;
    int eksp;
    struct _Term* next;
}Term;

Term* makeTerm(int koef, int eksp){
    Term* new=(Term*)malloc(sizeof(Term));
    if(!new){
        printf("Greska pri alokaciji memorije\n");
        return NULL;
    }
    new->koef=koef;
    new->eksp=eksp;
    new->next=NULL;
    return new;
}

/* Ubacuje clan SORTIRANO (od najveceg eksponenta prema najmanjem).
   Ako clan s tim eksponentom vec postoji, koeficijenti se zbroje.
   Ako zbroj ispadne 0, clan se brise. */
int insertSorted(Term* head, int koef, int eksp){
    if(koef==0)return 0;          /* clan s koeficijentom 0 ne treba spremati */

    Term* temp=head;
    /* idemo dok je sljedeci eksponent VECI od naseg */
    while(temp->next!=NULL&&temp->next->eksp>eksp){
        temp=temp->next;
    }

    /* isti eksponent vec postoji -> zbrajamo koeficijente */
    if(temp->next!=NULL&&temp->next->eksp==eksp){
        temp->next->koef+=koef;
        if(temp->next->koef==0){   /* npr. 3x^2 + (-3x^2) = 0 -> brisemo clan */
            Term* forDeleting=temp->next;
            temp->next=forDeleting->next;
            free(forDeleting);
        }
        return 0;
    }

    /* inace ubacujemo novi clan izmedu temp i temp->next */
    Term* new=makeTerm(koef,eksp);
    if(!new)return 1;
    new->next=temp->next;
    temp->next=new;
    return 0;
}

/* Cita jedan redak oblika "koef eksp koef eksp ..." i radi polinom */
int parseLine(Term* head, const char* line){
    int koef, eksp, n;
    const char* p=line;
    /* %n sprema koliko je znakova procitano, pa se pomicemo dalje kroz redak */
    while(sscanf(p,"%d %d %n",&koef,&eksp,&n)==2){
        if(insertSorted(head,koef,eksp)!=0)return 1;
        p+=n;
    }
    return 0;
}

/* Cita dva polinoma iz datoteke: prvi redak = P1, drugi redak = P2 */
int readFromFile(Term* p1, Term* p2, const char* filename){
    FILE* fp=fopen(filename,"r");
    if(!fp){
        printf("Greska pri otvaranju datoteke %s\n",filename);
        return 1;
    }
    char line[MAX_LINE];

    if(fgets(line,MAX_LINE,fp)==NULL){
        printf("U datoteci nema prvog polinoma\n");
        fclose(fp);
        return 1;
    }
    parseLine(p1,line);

    if(fgets(line,MAX_LINE,fp)==NULL){
        printf("U datoteci nema drugog polinoma\n");
        fclose(fp);
        return 1;
    }
    parseLine(p2,line);

    fclose(fp);
    return 0;
}

/* Ispis u obliku: 5x^4 - 3x^2 + 2x + 7 */
int print(const char* naziv, Term* head){
    Term* temp=head->next;
    printf("%s = ",naziv);
    if(temp==NULL){
        printf("0\n");
        return 0;
    }
    int prvi=1;
    while(temp!=NULL){
        int k=temp->koef;
        /* predznak */
        if(prvi){
            if(k<0)printf("-");
        }else{
            printf(k<0?" - ":" + ");
        }
        if(k<0)k=-k;

        /* koeficijent (1 se ne pise, osim kod konstante) */
        if(k!=1||temp->eksp==0)printf("%d",k);

        /* x i eksponent */
        if(temp->eksp==1)printf("x");
        else if(temp->eksp!=0)printf("x^%d",temp->eksp);

        prvi=0;
        temp=temp->next;
    }
    printf("\n");
    return 0;
}

/* Zbrajanje: sve clanove iz P1 i P2 ubacimo u rezultat,
   insertSorted sam zbroji clanove s istim eksponentom */
int addPoly(Term* p1, Term* p2, Term* result){
    Term* temp;
    for(temp=p1->next;temp!=NULL;temp=temp->next){
        if(insertSorted(result,temp->koef,temp->eksp)!=0)return 1;
    }
    for(temp=p2->next;temp!=NULL;temp=temp->next){
        if(insertSorted(result,temp->koef,temp->eksp)!=0)return 1;
    }
    return 0;
}

/* Mnozenje: svaki clan iz P1 pomnozimo sa svakim clanom iz P2
   (koeficijenti se mnoze, eksponenti zbrajaju) */
int multiplyPoly(Term* p1, Term* p2, Term* result){
    Term* a;
    Term* b;
    for(a=p1->next;a!=NULL;a=a->next){
        for(b=p2->next;b!=NULL;b=b->next){
            if(insertSorted(result,a->koef*b->koef,a->eksp+b->eksp)!=0)return 1;
        }
    }
    return 0;
}

int freeList(Term* head){
    Term* temp=head->next;
    while(temp!=NULL){
        Term* next=temp->next;
        free(temp);
        temp=next;
    }
    head->next=NULL;
    return 0;
}

int main(){
    Term p1={.koef=0,.eksp=0,.next=NULL};
    Term p2={.koef=0,.eksp=0,.next=NULL};
    Term suma={.koef=0,.eksp=0,.next=NULL};
    Term produkt={.koef=0,.eksp=0,.next=NULL};

    if(readFromFile(&p1,&p2,"polinomi.txt")!=0){
        freeList(&p1);
        freeList(&p2);
        return 1;
    }

    print("P1",&p1);
    print("P2",&p2);

    addPoly(&p1,&p2,&suma);
    print("P1 + P2",&suma);

    multiplyPoly(&p1,&p2,&produkt);
    print("P1 * P2",&produkt);

    freeList(&p1);
    freeList(&p2);
    freeList(&suma);
    freeList(&produkt);
    return 0;
}
