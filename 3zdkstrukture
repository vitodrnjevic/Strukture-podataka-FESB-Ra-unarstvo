/* NOVO 3.A
int addAfter(Person* head, const char* target, const char* ime, const char* prezime, int godina){
    Person* temp=findBySurname(head,target);
    if(temp==NULL){
        printf("Osoba s prezimenom %s nije pronadena\n",target);
        return 1;
    }
    Person* new=makePerson(ime,prezime,godina);
    if(!new)return 1;
    new->next=temp->next;
    temp->next=new;
    return 0;
}

/* NOVO 3.B 
int addBefore(Person* head, const char* target, const char* ime, const char* prezime, int godina){
    Person* temp=head;   /* trazimo element PRIJE trazenog (isto kao u deleteElement) */
    while(temp->next!=NULL&&strcmp(temp->next->prezime,target)!=0){
        temp=temp->next;
    }
    if(temp->next==NULL){
        printf("Osoba s prezimenom %s nije pronadena\n",target);
        return 1;
    }
    Person* new=makePerson(ime,prezime,godina);
    if(!new)return 1;
    new->next=temp->next;
    temp->next=new;
    return 0;
}

/* NOVO 3.C
int sortBySurname(Person* head){
    Person* end=NULL;
    Person* prev;
    Person* cur;
    Person* nxt;
    if(head->next==NULL||head->next->next==NULL)return 0;  
    while(head->next->next!=end){
        prev=head;
        cur=head->next;
        while(cur->next!=end){
            nxt=cur->next;
            if(strcmp(cur->prezime,nxt->prezime)>0){
                /* zamjena cur i nxt */
                cur->next=nxt->next;
                nxt->next=cur;
                prev->next=nxt;
                cur=nxt;
            }
            prev=cur;
            cur=cur->next;
        }
        end=cur;   
    return 0;
}
}

int writeToFile(Person* head, const char* filename){
    FILE* fp=fopen(filename,"w");
    if(!fp){
        printf("Greska pri otvaranju datoteke %s\n",filename);
        return 1;
    }
    Person* temp=head->next;
    while(temp!=NULL){
        fprintf(fp,"%s %s %d\n",temp->ime,temp->prezime,temp->godina);
        temp=temp->next;
    }
    fclose(fp);
    printf("Lista je upisana u datoteku %s\n",filename);
    return 0;
}

/* NOVO 3.E 
int readFromFile(Person* head, const char* filename){
    FILE* fp=fopen(filename,"r");
    if(!fp){
        printf("Greska pri otvaranju datoteke %s\n",filename);
        return 1;
    }
    char ime[50], prezime[50];
    int godina;
    freeList(head);
    while(fscanf(fp,"%49s %49s %d",ime,prezime,&godina)==3){
        if(addToEnd(head,ime,prezime,godina)!=0){
            fclose(fp);
            return 1;
        }
    }
    fclose(fp);
    printf("Lista je procitana iz datoteke %s\n",filename);
    return 0;
}

int main(){
    Person head={
        .ime="",
        .prezime="",
        .godina=0,
        .next=NULL
    };
    start(&head,"Ivo","Ivic",2000);
    start(&head,"Ana","Anicic",2002);
    addToEnd(&head,"Marko","Markic",2004);
    print(&head);
    printf("Trazimo sada prezime Anicic:\n");
    Person* naden=findBySurname(&head,"Anicic");
    if(naden){
        printf("Pronaden: %s %s (%d)\n",naden->ime,naden->prezime,naden->godina);
    }else{
        printf("Osoba nije pronadena\n");
    }
    deleteElement(&head,"Anicic");
    print(&head);
    printf("3.A Dodajemo Petra Peric iza Ivic:\n");
    addAfter(&head,"Ivic","Petra","Peric",2001);
    print(&head);

    printf("3.B Dodajemo Luka Babic ispred Markic:\n");
    addBefore(&head,"Markic","Luka","Babic",1999);
    print(&head);

    printf("3.C Sortiranje po prezimenima:\n");
    sortBySurname(&head);
    print(&head);

    printf("3.D Upis u datoteku:\n");
    writeToFile(&head,"osobe.txt");

    printf("3.E Brisemo listu i citamo je iz datoteke:\n");
    freeList(&head);
    print(&head);
    readFromFile(&head,"osobe.txt");
    print(&head);

    freeList(&head);
    return 0;
}
